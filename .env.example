# The Recall key and URL must belong to the same workspace and region.
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1

# HTTPS tunnel to the tool callback server on port 7862 (not the launcher).
ELEVENLABS_TOOLS_ORIGIN=

# Run python -m app.agent after setting the API key and tools origin.
# Copy the returned agent ID here. The runtime only needs the agent ID.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional voice ID available in your ElevenLabs account; otherwise use its default.
ELEVENLABS_VOICE_ID=

# Use the same value when configuring the hosted agent and running the demo.
SESSION_TIMEOUT_SECONDS=600
